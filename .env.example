# =============================================================================
# HYROST REALM — Environment Configuration
# =============================================================================
# Salin file ini menjadi .env di ROOT project (bukan di folder backend/):
#
#   cp .env.example .env
#
# Backend memuat .env dari: backend/server.js → path.join(__dirname, "../.env")
# =============================================================================


# ─── SERVER ───────────────────────────────────────────────────────────────────

# Port HTTP Express (default: 3044)
PORT=3044

# development | production
# - production: JWT_SECRET wajib diisi (server exit jika kosong)
# - PM2: NODE_ENV diatur otomatis via ecosystem.config.js
NODE_ENV=development


# ─── AUTH & KEAMANAN ─────────────────────────────────────────────────────────

# Secret untuk sign/verify JWT login (Gunakan string acak minimal 64 karakter)
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production_min_64_chars

# Secret untuk refresh token (Otomatis di-generate aman jika kosong)
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_min_64_chars

# Google OAuth Client ID (login dengan Google)
# Dapatkan dari: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com


# ─── DATABASE MYSQL (UTAMA) ──────────────────────────────────────────────────

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=hyrost

# Catatan: Jika MySQL tidak tersedia, backend fallback ke in-memory (dev only).


# ─── ADMIN PERTAMA (OPSIONAL) ─────────────────────────────────────────────────

# Hanya dipakai saat startup jika akun admin belum ada.
# Jangan commit nilai asli ke git.
ADMIN_SEED_USERNAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=


# ─── CORS ────────────────────────────────────────────────────────────────────

# Domain yang boleh mengakses API (pisahkan dengan koma, tanpa spasi)
# WAJIB tambahkan domain production saat deploy VPS.
ALLOWED_ORIGINS=http://localhost:3044,http://127.0.0.1:3044,https://your-domain.com


# ─── MINECRAFT PLUGIN BRIDGE (WAJIB untuk integrasi in-game) ─────────────────

# API key rahasia — harus SAMA dengan config plugin (header: X-Bridge-Api-Key)
# Tanpa ini: status server realtime, delivery item, link akun, redeem → error 503
MINECRAFT_BRIDGE_KEY=your_bridge_secret_here

# ID plugin (default: hyrost_bridge) — opsional
MINECRAFT_PLUGIN_ID=hyrost_bridge

# Lihat docs/MINECRAFT_PLUGIN_SPEC.md untuk endpoint plugin.


# ─── MONGODB (LEGACY / OPSIONAL) ─────────────────────────────────────────────

# Sebagian besar fitur sudah memakai MySQL. Mongo hanya untuk kode legacy.
# Boleh dikosongkan atau dihapus jika tidak dipakai.
MONGO_URI=mongodb://127.0.0.1:27017/hyrost


# =============================================================================
# TIDAK PERLU DI .env — dikonfigurasi lewat Admin Panel (database settings)
# =============================================================================
#
#   server_ip          → IP/domain Minecraft yang ditampilkan di website
#   server_port        → Port Minecraft (default 25565)
#   server_name        → Nama realm
#   server_status_auto → Auto-ping status via mcsrvstat (true/false)
#
# Live Hub (chat/aktivitas realtime web) → tidak butuh env, berjalan in-memory.
# =============================================================================


# ─── LOCAL FILE STORAGE (data/) ─────────────────────────────────────────────

# Folder penyimpanan lokal aman (relatif ke root project)
LOCAL_DATA_DIR=data

# Sync fallback database ke data/store/database.json (true/false)
LOCAL_STORE_SYNC=true

# Auto-backup MySQL ke data/backups/ (terenkripsi AES-256-GCM)
LOCAL_BACKUP_ENABLED=true
LOCAL_BACKUP_INTERVAL_HOURS=24
LOCAL_BACKUP_KEEP=7
LOCAL_BACKUP_ENCRYPT=true

# Key enkripsi backup (opsional — default derivasi dari JWT_SECRET)
# LOCAL_BACKUP_KEY=


# ─── GOOGLE DRIVE BACKUP (opsional — off-site cloud) ─────────────────────────

# Aktifkan upload otomatis backup .hybk ke Google Drive
GOOGLE_DRIVE_ENABLED=false

# Folder ID dari URL Drive (folder harus di-share ke service account email)
GOOGLE_DRIVE_FOLDER_ID=

# Path ke JSON key service account (relatif ke root project)
GOOGLE_DRIVE_CREDENTIALS=credentials/google-drive-service-account.json

# Jumlah backup terakhir yang disimpan di Drive
GOOGLE_DRIVE_KEEP=14

# Setup: docs/GOOGLE_DRIVE_SETUP.md


# ─── EMAIL (SMTP) ────────────────────────────────────────────────────────────

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@hyrost.net


# ─── MIDTRANS PAYMENT GATEWAY ─────────────────────────────────────────────────

MIDTRANS_ENABLED=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=


# ─── DISCORD INTEGRATION & DEVELOPER PORTAL ────────────────────────────────
# Dapatkan dari Discord Developer Portal -> Application (Mei) -> General Information & OAuth2
DISCORD_CLIENT_ID=1391337610156445766
DISCORD_PUBLIC_KEY=73ff504b5993096c4fa630f7d1baa6b52f5c930521168dcb5484f9765719f5a5
DISCORD_CLIENT_SECRET=
DISCORD_WEBHOOK_URL=
