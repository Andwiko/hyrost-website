# =============================================================================
# HYROST Web & API Server Configuration (.htaccess)
# Web Security Hardening, Dotfile Protection & Reverse Proxy Routing
# =============================================================================

# 1. Nonaktifkan Directory Listing (mencegah penjelajahan isi folder publik)
Options -Indexes

# 2. Blokir Akses ke File Sensitif & Tersembunyi (Apache 2.4 & 2.2 Compatibility)
<IfModule mod_authz_core.c>
    # Blokir semua file yang diawali titik (.env, .git, .htaccess, .npmrc, dll)
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>

    # Blokir file ekstensi sensitif, backup, database & script server
    <FilesMatch "\.(bak|backup|old|save|env.*|sql|db|sqlite|log|ini|sh|ps1|yml|yaml|zip|tar|gz|lock)$">
        Require all denied
    </FilesMatch>

    # Blokir script admin lokal
    <FilesMatch "(create_admin_account|make_admin|set_admin|ecosystem\.config)\.js$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "\.(bak|backup|old|save|env.*|sql|db|sqlite|log|ini|sh|ps1|yml|yaml|zip|tar|gz|lock)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# 3. Routing & Rewrite Rules
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Blokir akses ke folder sensitif
    RewriteRule ^(data|credentials|backend|database|\.git|\.github|\.npm)(/|$) - [F,L]

    # Forward request /api/ ke Node.js Backend Port 3044
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api/(.*)$ http://127.0.0.1:3044/api/$1 [P,L]

    # Clean URL routing untuk file HTML statis
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# 4. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>
