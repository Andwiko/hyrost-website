# =============================================================================
# HYROST Web & API Server Configuration (.htaccess)
# Web Security Hardening, Path Traversal Shield & Stealth Route Masking (?=pv3Ad)
# =============================================================================

# 1. Nonaktifkan Directory Listing (Mencegah penjelajahan isi folder publik)
Options -Indexes -MultiViews

# 2. Blokir Akses ke File Sensitif, Tersembunyi & Konfigurasi Server
<IfModule mod_authz_core.c>
    # Blokir semua file tersembunyi / dotfiles (.env, .git, .htaccess, .npmrc, dll)
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>

    # Blokir file ekstensi sensitif, backup, database & script server internal
    <FilesMatch "\.(bak|backup|old|save|env.*|sql|db|sqlite|log|ini|sh|ps1|yml|yaml|zip|tar|gz|lock|md|json|hybk|key|pem|crt)$">
        Require all denied
    </FilesMatch>

    # Blokir script server / admin / testing lokal
    <FilesMatch "(create_admin_account|make_admin|set_admin|ecosystem\.config|test_.*)\.js$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "\.(bak|backup|old|save|env.*|sql|db|sqlite|log|ini|sh|ps1|yml|yaml|zip|tar|gz|lock|md|json|hybk|key|pem|crt)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# 3. Web Application Firewall (WAF) & Stealth Route Masking Rules
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 3.1 Blokir Karakter Berbahaya dalam URL (Null Bytes, Path Traversal, Hex Evading)
    RewriteCond %{THE_REQUEST} (\0|\r|\n) [NC,OR]
    RewriteCond %{THE_REQUEST} (\.\./|\.\.\\|%2e%2e%2f|%2e%2e/|\.\.%2f|%252e%252e) [NC,OR]
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|%2e%2e%2f|%2e%2e/|\.\.%2f) [NC]
    RewriteRule ^.*$ - [F,L]

    # 3.2 Blokir Serangan Injection Populer (SQLi, XSS, Base64 Eval dalam Query String)
    RewriteCond %{QUERY_STRING} (base64_encode[^(]*\([^)]*\)|base64_decode[^(]*\([^)]*\)) [NC,OR]
    RewriteCond %{QUERY_STRING} (<|%3C)([^s]*s)+cript.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} (union.*select|insert.*into|drop.*table|select.*from|concat.*\(|information_schema) [NC,OR]
    RewriteCond %{QUERY_STRING} (GLOBALS|REQUEST)(_|\.|\[|%5B) [NC,OR]
    RewriteCond %{QUERY_STRING} (mosConfig_[a-zA-Z_]{1,21}(=|\%3D)) [NC,OR]
    RewriteCond %{QUERY_STRING} (/etc/passwd|/proc/self/environ|cmd=|exec\() [NC]
    RewriteRule ^.*$ - [F,L]

    # 3.3 Blokir akses langsung ke folder server internal
    RewriteRule ^(data|credentials|backend|database|node_modules|scratch|\.system_generated|\.git|\.github|\.gemini)(/|$) - [F,L]

    # 3.4 STEALTH TOKEN REWRITES (Sajikan Konten Tepat Sesuai Token di Root URL)
    RewriteCond %{QUERY_STRING} (^|=)pv3Ad($|&) [NC]
    RewriteRule ^(index\.html)?$ dashboard.html [L]

    RewriteCond %{QUERY_STRING} (^|=)sK1nS($|&) [NC]
    RewriteRule ^(index\.html)?$ bot/skin.html [L]

    RewriteCond %{QUERY_STRING} (^|=)sKStD($|&) [NC]
    RewriteRule ^(index\.html)?$ bot/skin-studio.html [L]

    RewriteCond %{QUERY_STRING} (^|=)b0tM3($|&) [NC]
    RewriteRule ^(index\.html)?$ bot/index.html [L]

    RewriteCond %{QUERY_STRING} (^|=)bChLog($|&) [NC]
    RewriteRule ^(index\.html)?$ bot/changelog.html [L]

    RewriteCond %{QUERY_STRING} (^|=)xK9Lm($|&) [NC]
    RewriteRule ^(index\.html)?$ modules/admin.html [L]

    RewriteCond %{QUERY_STRING} (^|=)t7Y4b($|&) [NC]
    RewriteRule ^(index\.html)?$ modules/store.html [L]

    RewriteCond %{QUERY_STRING} (^|=)lDb8R($|&) [NC]
    RewriteRule ^(index\.html)?$ modules/leaderboard.html [L]

    RewriteCond %{QUERY_STRING} (^|=)rW9Dz($|&) [NC]
    RewriteRule ^(index\.html)?$ modules/rewards.html [L]

    RewriteCond %{QUERY_STRING} (^|=)f0rUm($|&) [NC]
    RewriteRule ^(index\.html)?$ modules/forum.html [L]

    RewriteCond %{QUERY_STRING} (^|=)fThR8($|&) [NC]
    RewriteRule ^(index\.html)?$ modules/forum-thread.html [L]

    RewriteCond %{QUERY_STRING} (^|=)wK1iX($|&) [NC]
    RewriteRule ^(index\.html)?$ modules/wiki.html [L]

    RewriteCond %{QUERY_STRING} (^|=)wArT9($|&) [NC]
    RewriteRule ^(index\.html)?$ modules/wiki-article.html [L]

    RewriteCond %{QUERY_STRING} (^|=)s0cIa($|&) [NC]
    RewriteRule ^(index\.html)?$ modules/social.html [L]

    RewriteCond %{QUERY_STRING} (^|=)sUp7P($|&) [NC]
    RewriteRule ^(index\.html)?$ modules/support.html [L]

    RewriteCond %{QUERY_STRING} (^|=)mAp3D($|&) [NC]
    RewriteRule ^(index\.html)?$ modules/map.html [L]

    RewriteCond %{QUERY_STRING} (^|=)sHw6C($|&) [NC]
    RewriteRule ^(index\.html)?$ modules/showcase.html [L]

    RewriteCond %{QUERY_STRING} (^|=)mProf($|&) [NC]
    RewriteRule ^(index\.html)?$ modules/profile.html [L]

    RewriteCond %{QUERY_STRING} (^|=)mSkSt($|&) [NC]
    RewriteRule ^(index\.html)?$ modules/skin-studio.html [L]

    RewriteCond %{QUERY_STRING} (^|=)r0lSh($|&) [NC]
    RewriteRule ^(index\.html)?$ modules/role_shop.html [L]

    RewriteCond %{QUERY_STRING} (^|=)mChat($|&) [NC]
    RewriteRule ^(index\.html)?$ modules/chat.html [L]

    RewriteCond %{QUERY_STRING} (^|=)aCc9T($|&) [NC]
    RewriteRule ^(index\.html)?$ account/index.html [L]

    RewriteCond %{QUERY_STRING} (^|=)iNv4K($|&) [NC]
    RewriteRule ^(index\.html)?$ inventory/inventory.html [L]

    RewriteCond %{QUERY_STRING} (^|=)mK7tP($|&) [NC]
    RewriteRule ^(index\.html)?$ marketplace/index.html [L]

    RewriteCond %{QUERY_STRING} (^|=)mSh0p($|&) [NC]
    RewriteRule ^(index\.html)?$ marketplace/shop.html [L]

    RewriteCond %{QUERY_STRING} (^|=)mAuc7($|&) [NC]
    RewriteRule ^(index\.html)?$ marketplace/auction.html [L]

    RewriteCond %{QUERY_STRING} (^|=)mCrt2($|&) [NC]
    RewriteRule ^(index\.html)?$ marketplace/cart.html [L]

    RewriteCond %{QUERY_STRING} (^|=)mChk8($|&) [NC]
    RewriteRule ^(index\.html)?$ marketplace/checkout.html [L]

    RewriteCond %{QUERY_STRING} (^|=)mUpl5($|&) [NC]
    RewriteRule ^(index\.html)?$ marketplace/upload.html [L]

    RewriteCond %{QUERY_STRING} (^|=)Lg8In($|&) [NC]
    RewriteRule ^(index\.html)?$ auth/login.html [L]

    RewriteCond %{QUERY_STRING} (^|=)Rg3St($|&) [NC]
    RewriteRule ^(index\.html)?$ auth/register.html [L]

    RewriteCond %{QUERY_STRING} (^|=)fOrgP($|&) [NC]
    RewriteRule ^(index\.html)?$ auth/forgot-password.html [L]

    RewriteCond %{QUERY_STRING} (^|=)rSetP($|&) [NC]
    RewriteRule ^(index\.html)?$ auth/reset-password.html [L]

    RewriteCond %{QUERY_STRING} (^|=)pRv1C($|&) [NC]
    RewriteRule ^(index\.html)?$ privacy.html [L]

    RewriteCond %{QUERY_STRING} (^|=)tRm9S($|&) [NC]
    RewriteRule ^(index\.html)?$ terms.html [L]

    RewriteCond %{QUERY_STRING} (^|=)vRf8U($|&) [NC]
    RewriteRule ^(index\.html)?$ verify-user.html [L]

    # 3.5 Forward request /api/ dan /uploads/ ke Node.js Backend Port 3044 (Reverse Proxy)
    <IfModule mod_proxy.c>
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteRule ^api/(.*)$ http://127.0.0.1:3044/api/$1 [P,L]
    </IfModule>

    # 3.6 Redirect /index.html ke /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html[\s\?] [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # 3.7 Clean URL Fallback
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.+)$ $1.html [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# 4. HTTP Security & Anti-MIME Sniffing Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header unset X-Powered-By
    Header unset Server

    # Revalidasi file HTML agar perubahan UI langsung tampil tanpa cache lama
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Cache file aset publik (CSS, JS, gambar, font)
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|webp|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, stale-while-revalidate=86400"
    </FilesMatch>
</IfModule>

# 5. Enable GZIP & Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
</IfModule>
