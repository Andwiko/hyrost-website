# =============================================================================
# HYROST Web & API Server Configuration (.htaccess)
# Web Security Hardening, Path Traversal Shield & Stealth Route Masking (?=pv3Ad)
# =============================================================================

# 1. Nonaktifkan Directory Listing (Mencegah penjelajahan isi folder publik)
Options -Indexes -MultiViews

# 2. Blokir Akses ke File Sensitif, Tersembunyi & Konfigurasi Server
<IfModule mod_authz_core.c>
    # Blokir semua file tersembunyi / dotfiles (.env, .git, .htaccess, .npmrc, dll)
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>

    # Blokir file ekstensi sensitif, backup, database & script server internal
    <FilesMatch "\.(bak|backup|old|save|env.*|sql|db|sqlite|log|ini|sh|ps1|yml|yaml|zip|tar|gz|lock|md|json|hybk|key|pem|crt)$">
        Require all denied
    </FilesMatch>

    # Blokir script server / admin / testing lokal
    <FilesMatch "(create_admin_account|make_admin|set_admin|ecosystem\.config|test_.*)\.js$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "\.(bak|backup|old|save|env.*|sql|db|sqlite|log|ini|sh|ps1|yml|yaml|zip|tar|gz|lock|md|json|hybk|key|pem|crt)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# 3. Web Application Firewall (WAF) & Stealth Route Masking Rules
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 3.1 Blokir Karakter Berbahaya dalam URL (Null Bytes, Path Traversal, Hex Evading)
    RewriteCond %{THE_REQUEST} (\0|\r|\n) [NC,OR]
    RewriteCond %{THE_REQUEST} (\.\./|\.\.\\|%2e%2e%2f|%2e%2e/|\.\.%2f|%252e%252e) [NC,OR]
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|%2e%2e%2f|%2e%2e/|\.\.%2f) [NC]
    RewriteRule ^.*$ - [F,L]

    # 3.2 Blokir Serangan Injection Populer (SQLi, XSS, Base64 Eval dalam Query String)
    RewriteCond %{QUERY_STRING} (base64_encode[^(]*\([^)]*\)|base64_decode[^(]*\([^)]*\)) [NC,OR]
    RewriteCond %{QUERY_STRING} (<|%3C)([^s]*s)+cript.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} (union.*select|insert.*into|drop.*table|select.*from|concat.*\(|information_schema) [NC,OR]
    RewriteCond %{QUERY_STRING} (GLOBALS|REQUEST)(_|\.|\[|%5B) [NC,OR]
    RewriteCond %{QUERY_STRING} (mosConfig_[a-zA-Z_]{1,21}(=|\%3D)) [NC,OR]
    RewriteCond %{QUERY_STRING} (/etc/passwd|/proc/self/environ|cmd=|exec\() [NC]
    RewriteRule ^.*$ - [F,L]

    # 3.3 Blokir akses langsung ke folder server internal
    RewriteRule ^(data|credentials|backend|database|node_modules|scratch|\.system_generated|\.git|\.github|\.gemini)(/|$) - [F,L]

    # 3.4 Forward request /api/ dan /uploads/ ke Node.js Backend Port 3044 (Reverse Proxy)
    <IfModule mod_proxy.c>
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteRule ^api/(.*)$ http://127.0.0.1:3044/api/$1 [P,L]
    </IfModule>

    # 3.5 STEALTH OPAQUE ROUTE REDIRECTS (Alihkan Nama File Asli ke Token Samaran)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /dashboard(\.html)?[\s\?] [NC]
    RewriteRule ^.*$ /?=pv3Ad [R=302,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /bot/skin(\.html)?[\s\?] [NC]
    RewriteRule ^.*$ /?=sK1nS [R=302,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /bot/index(\.html)?[\s\?] [NC]
    RewriteRule ^.*$ /?=b0tM3 [R=302,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /modules/admin(\.html)?[\s\?] [NC]
    RewriteRule ^.*$ /?=xK9Lm [R=302,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /modules/store(\.html)?[\s\?] [NC]
    RewriteRule ^.*$ /?=t7Y4b [R=302,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /modules/leaderboard(\.html)?[\s\?] [NC]
    RewriteRule ^.*$ /?=lDb8R [R=302,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /modules/rewards(\.html)?[\s\?] [NC]
    RewriteRule ^.*$ /?=rW9Dz [R=302,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /modules/forum(\.html)?[\s\?] [NC]
    RewriteRule ^.*$ /?=f0rUm [R=302,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /modules/wiki(\.html)?[\s\?] [NC]
    RewriteRule ^.*$ /?=wK1iX [R=302,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /auth/login(\.html)?[\s\?] [NC]
    RewriteRule ^.*$ /?=Lg8In [R=302,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /auth/register(\.html)?[\s\?] [NC]
    RewriteRule ^.*$ /?=Rg3St [R=302,L]

    # Redirect /index.html ke /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html[\s\?] [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # 3.6 STEALTH TOKEN RESOLVER (Sajikan Konten Berdasarkan Query Token)
    RewriteCond %{QUERY_STRING} (^|=)pv3Ad($|&) [NC]
    RewriteRule ^$ dashboard.html [L]

    RewriteCond %{QUERY_STRING} (^|=)sK1nS($|&) [NC]
    RewriteRule ^$ bot/skin.html [L]

    RewriteCond %{QUERY_STRING} (^|=)b0tM3($|&) [NC]
    RewriteRule ^$ bot/index.html [L]

    RewriteCond %{QUERY_STRING} (^|=)xK9Lm($|&) [NC]
    RewriteRule ^$ modules/admin.html [L]

    RewriteCond %{QUERY_STRING} (^|=)t7Y4b($|&) [NC]
    RewriteRule ^$ modules/store.html [L]

    RewriteCond %{QUERY_STRING} (^|=)lDb8R($|&) [NC]
    RewriteRule ^$ modules/leaderboard.html [L]

    RewriteCond %{QUERY_STRING} (^|=)rW9Dz($|&) [NC]
    RewriteRule ^$ modules/rewards.html [L]

    RewriteCond %{QUERY_STRING} (^|=)f0rUm($|&) [NC]
    RewriteRule ^$ modules/forum.html [L]

    RewriteCond %{QUERY_STRING} (^|=)wK1iX($|&) [NC]
    RewriteRule ^$ modules/wiki.html [L]

    RewriteCond %{QUERY_STRING} (^|=)Lg8In($|&) [NC]
    RewriteRule ^$ auth/login.html [L]

    RewriteCond %{QUERY_STRING} (^|=)Rg3St($|&) [NC]
    RewriteRule ^$ auth/register.html [L]

    # 3.7 Clean URL Fallback
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.+)$ $1.html [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# 4. HTTP Security & Anti-MIME Sniffing Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header unset X-Powered-By
    Header unset Server

    # Revalidasi file HTML agar perubahan UI langsung tampil tanpa cache lama
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Cache file aset publik (CSS, JS, gambar, font)
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|webp|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, stale-while-revalidate=86400"
    </FilesMatch>
</IfModule>

# 5. Enable GZIP & Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
</IfModule>
